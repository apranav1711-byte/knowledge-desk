# --- Supabase (Project Settings -> API / Database) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-side only. NEVER put this in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for projects still using the legacy HS256 JWT secret (new projects use JWKS automatically).
SUPABASE_JWT_SECRET=
# Postgres connection string (Database -> Connection string -> Session pooler or Direct). Role must be able to
# use the `private` schema (the default `postgres` role can).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# bge = real BAAI/bge-small-en-v1.5 (fastembed, ONNX, CPU). hash = deterministic offline fallback for tests only.
EMBEDDING_BACKEND=bge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=./data/models
RETRIEVAL_MIN_SCORE=0.55
MAX_UPLOAD_BYTES=26214400
